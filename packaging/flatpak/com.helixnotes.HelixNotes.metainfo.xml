<component type="desktop-application">
  <id>com.helixnotes.HelixNotes</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <name>HelixNotes</name>
  <summary>Write and organize local Markdown notes</summary>
  <developer id="com.helixnotes">
    <name>Yuri Karamian</name>
  </developer>
  <description>
    <p>HelixNotes keeps your notes as Markdown files in a folder you choose.
    Organize them into notebooks, add tags, link related notes and search across
    your collection.</p>
    <p>The Tasks view brings together checklists from your notes in a list or
    calendar.</p>
  </description>
  <launchable type="desktop-id">com.helixnotes.HelixNotes.desktop</launchable>
  <url type="homepage">https://helixnotes.com</url>
  <url type="vcs-browser">https://gitlab.com/ArkHost/HelixNotes</url>
  <url type="bugtracker">https://gitlab.com/ArkHost/HelixNotes/-/issues</url>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="1.3.7" type="stable" date="2026-11-10">
      <description>
        <p>Add notebook and tag icons, ten themes, mobile layout fixes and a
        Flatpak package.</p>
      </description>
    </release>
  </releases>
  <provides>
    <binary>helixnotes</binary>
  </provides>
  <screenshots>
    <screenshot type="default">
      <caption>Markdown editor</caption>
      <image type="source">https://cdn.helixnotes.com/assets/screenshots/screenshot-1.png</image>
    </screenshot>
    <screenshot>
      <caption>Tasks calendar</caption>
      <image type="source">https://cdn.helixnotes.com/assets/screenshots/screenshot-2.png</image>
    </screenshot>
  </screenshots>
</component>
